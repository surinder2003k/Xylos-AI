# Supabase (Required for Auth & DB)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Provider API Keys (Optional, users can add their own)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_GEMINI_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Cron Secret for Auto-Posting Security
CRON_SECRET=your-cron-secret-here

# Encryption (Standard env var for MVP)
ENCRYPTION_SECRET=your-32-character-secret-key-here

# Email (Optional)
RESEND_API_KEY=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=